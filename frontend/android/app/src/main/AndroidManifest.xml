<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- CAMERA is required by the Record screen to capture the user's swing
         video. The camera_android_camerax plugin also declares it in its own
         manifest, but it is declared explicitly here so the app's full
         permission surface is visible in this file. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Permissions that plugins merge in but this app never uses. Not
         declaring them here is NOT enough: the manifest merger pulls them in
         from the plugins' own manifests regardless, so each must be stripped
         explicitly with tools:node="remove". Verify with the merged manifest
         (build/app/intermediates/merged_manifest/...), never this file alone.

         RECORD_AUDIO - from camera_android_camerax's own manifest. The Record
           screen builds its CameraController with `enableAudio: false` (see
           lib/screens/record_screen.dart) and camerax gates its runtime
           microphone request on that flag, so it is never requested. The
           pipeline is purely visual. Remove this line only if `enableAudio`
           is ever turned on.

         WRITE_EXTERNAL_STORAGE - from camera_android_camerax, scoped to
           maxSdkVersion 28. Unneeded: camerax writes every capture with
           File.createTempFile(..., context.getCacheDir()), which is
           app-private and needs no permission on any Android version.

         READ_EXTERNAL_STORAGE - declared by NO plugin. The merger IMPLIES it
           ("camerax requested WRITE_EXTERNAL_STORAGE"), and the implied copy
           does NOT inherit WRITE's maxSdkVersion 28, so it widens to every
           Android version up to 12. Unneeded: android_file_picker reads the
           chosen video through ACTION_GET_CONTENT (the Storage Access
           Framework), which grants per-file access with no storage permission
           and makes no runtime permission request. -->
    <uses-permission
        android:name="android.permission.RECORD_AUDIO"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove" />
    <application
        android:label="Tennisimo"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
